<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      心跳：模块在微信进程里跑起来后会广播一次，App 收到才认定「微信内已生效」。
      protectionLevel=normal + App 自己 uses 一下，就满足 sendBroadcast(intent, receiverPermission)
      对接收方的权限要求；微信进程不需要持有任何权限，也就没给它加权限。
    -->
    <permission android:name="dev.goutou.wingman.permission.HEARTBEAT" android:protectionLevel="normal" />
    <uses-permission android:name="dev.goutou.wingman.permission.HEARTBEAT" />

    <application
        android:label="TalkTact"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="TalkTact：微信聊天副驾。读聊天页最近几条消息，给 3 条策略不同的候选回复；可按联系人写关系档案影响生成。只填入输入框，不自动发送。" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".HeartbeatReceiver" android:exported="true">
            <intent-filter>
                <action android:name="dev.goutou.wingman.HEARTBEAT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
