<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 本地代理要常驻监听回环端口，所以是个前台服务（类型 specialUse，见下面的 service 声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 前台服务的常驻通知（13+ 才有这个权限；用户不给也能跑，只是通知不显示） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      心跳：模块在微信进程里跑起来后会广播一次，App 收到才认定「微信内已生效」。
      protectionLevel=normal + App 自己 uses 一下，就满足 sendBroadcast(intent, receiverPermission)
      对接收方的权限要求；微信进程不需要持有任何权限，也就没给它加权限。
    -->
    <permission android:name="io.github.shibry88_netizen.talktact.permission.HEARTBEAT" android:protectionLevel="normal" />
    <uses-permission android:name="io.github.shibry88_netizen.talktact.permission.HEARTBEAT" />

    <!--
      现代 Xposed API：模块的身份不再靠下面那四个 meta-data 声明，而是靠 APK 里的
      META-INF/xposed/{module.prop, java_init.list, scope.list}（见 src/main/resources）。
      模块名 = android:label，描述 = android:description —— 这正是框架推荐的做法。

      迁移前的写法（已删除）：
        <meta-data android:name="xposedmodule" .../>        <meta-data android:name="xposeddescription" .../>
        <meta-data android:name="xposedminversion" .../>    <meta-data android:name="xposedscope" .../>
      再加上 assets/xposed_init。留着任何一条都会让框架按 legacy 模块处理。
    -->
    <application
        android:name=".TalkTactApp"
        android:label="TalkTact"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          本地代理：把「API Key 只留在 App 进程」这件事做成一条回环通道。
          exported=false：只有本机同 UID 或显式 startService 能拉起它；
          真正的门在代理服务器的 token 校验上（回环端口不等于「只有微信能连」）。
        -->
        <service
            android:name=".proxy.ProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="localLoopbackApiProxy" />
        </service>

        <receiver android:name=".HeartbeatReceiver" android:exported="true">
            <intent-filter>
                <action android:name="io.github.shibry88_netizen.talktact.HEARTBEAT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
